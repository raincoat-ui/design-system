{
  "name": "@raincoat-ui/react",
  "version": "0.1.0-next.4",
  "description": "Raincoat components for React: shadcn/ui components on Radix primitives, styled only with Raincoat design tokens.",
  "license": "Apache-2.0",
  "homepage": "https://raincoat-ui.github.io/design-system/",
  "bugs": "https://github.com/raincoat-ui/design-system/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raincoat-ui/design-system.git",
    "directory": "packages/web"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "tailwindcss",
    "shadcn",
    "radix",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/ui/button.d.ts",
      "default": "./dist/components/ui/button.js"
    },
    "./toast": {
      "types": "./dist/components/ui/toast.d.ts",
      "default": "./dist/components/ui/toast.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./ui.css": "./dist/ui.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/package/package.test.js && vitest run --project \"!*snapshots\"",
    "test:snapshots": "vitest run --project \"*snapshots\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@raincoat-ui/theme-base": "workspace:*",
    "@raincoat-ui/tokens": "workspace:*",
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.1",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}

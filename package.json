{
  "name": "raincoat-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Raincoat: one design-system foundation compiled to SwiftUI, Jetpack Compose, and React, with a theme per app.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raincoat-ui/design-system.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "toolchain": "node tools/doctor/doctor.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tools/**/*.test.mjs\" \"packages/*/test/*.test.js\"",
    "tokens:lint": "node packages/tokens/src/cli.js lint",
    "tokens:contrast": "node packages/tokens/src/cli.js contrast",
    "tokens:build": "node packages/tokens/src/cli.js build",
    "web:typecheck": "pnpm --filter @raincoat-ui/react typecheck",
    "web:build": "pnpm --filter @raincoat-ui/react build",
    "web:test": "pnpm --filter @raincoat-ui/react test",
    "web:browsers": "pnpm --filter @raincoat-ui/react exec playwright install --only-shell chromium",
    "docs:build": "pnpm --filter @raincoat-ui/docs build",
    "docs:dev": "pnpm --filter @raincoat-ui/docs dev",
    "licenses:check": "node tools/license-gate/check.mjs",
    "licenses:render": "node tools/license-gate/render-allowlist.mjs",
    "licenses:assets": "node tools/license-gate/assets.mjs",
    "tool": "node tools/ci/run-tool.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node tools/release/sync-versions.mjs && biome check --write .",
    "release:stage": "node tools/release/stage.mjs",
    "validate": "pnpm lint && pnpm test && pnpm tokens:lint && pnpm tokens:contrast && pnpm tokens:build --check && pnpm licenses:render --check && pnpm licenses:assets && pnpm licenses:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.1",
    "yaml": "2.9.1"
  }
}

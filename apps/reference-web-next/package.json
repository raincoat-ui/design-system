{
  "name": "@raincoat-ui/reference-web-next",
  "version": "0.0.0",
  "private": true,
  "description": "A Next.js app that renders every Raincoat component on a server the way an app uses it, and the browser tests that drive it.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../tools/reference/web-theme.mjs app/theme.css && NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "node ../../tools/reference/web-theme.mjs app/theme.css && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "test": "node ../../tools/reference/web-theme.mjs app/theme.css && NEXT_TELEMETRY_DISABLED=1 next build && playwright test"
  },
  "dependencies": {
    "@raincoat-ui/react": "workspace:*",
    "@raincoat-ui/theme-base": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's own text is in English only. This lets the Raincoat package still speak to
	     assistive technology in the person's language, where it has a translation. -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
</dict>
</plist>

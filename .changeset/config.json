{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "baseBranch": "main",
  "access": "public",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "format": false,
  "fixed": [
    [
      "@raincoat-ui/react",
      "@raincoat-ui/theme-base",
      "@raincoat-ui/tokens",
      "@raincoat-ui/swift",
      "@raincoat-ui/android"
    ]
  ],
  "linked": [],
  "ignore": ["@raincoat-ui/reference-web-vite"],
  "changedFilePatterns": [
    "src/**",
    "theme.css",
    "Sources/**",
    "Package.swift",
    "*/src/main/**",
    "*/build.gradle.kts"
  ],
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  }
}

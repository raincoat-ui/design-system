{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/generated",
      "!**/__snapshots__",
      "!**/__screenshots__",
      "!licenses/ALLOWLIST.md",
      "!licenses/allowlist.json",
      "!packages/web-themes/*/theme.css",
      "!CODE_OF_CONDUCT.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}

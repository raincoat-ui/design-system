{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raincoat-ui.github.io/design-system/schemas/component-spec.schema.json",
  "title": "Raincoat component spec",
  "description": "The platform-neutral contract of one component. This schema checks structure; the spec linter checks that defaults, examples, and token references are consistent.",
  "type": "object",
  "required": [
    "id",
    "name",
    "specVersion",
    "rfc",
    "group",
    "summary",
    "anatomy",
    "states",
    "accessibility",
    "internationalization",
    "examples"
  ],
  "oneOf": [{ "required": ["properties"] }, { "required": ["parts"] }],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/kebab" },
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
    "specVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "rfc": { "type": "integer", "minimum": 1 },
    "group": { "type": "string", "minLength": 1 },
    "summary": { "$ref": "#/$defs/prose" },
    "properties": { "$ref": "#/$defs/properties" },
    "parts": {
      "description": "The parts of a component that an app uses on their own, such as the Text and the Heading of Typography. Each part has properties of its own, and its generated types are named after it. A spec has either properties or parts.",
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "$ref": "#/$defs/kebab" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "summary", "properties"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
          "summary": { "$ref": "#/$defs/prose" },
          "properties": { "$ref": "#/$defs/properties" }
        }
      }
    },
    "content": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/kebab" },
      "additionalProperties": {
        "type": "object",
        "required": ["description", "required"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/prose" },
          "required": { "type": ["boolean", "string"] }
        }
      }
    },
    "anatomy": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/kebab" },
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/prose" },
          "tokens": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*(\\.\\*)?$" }
          }
        }
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/kebab" },
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": { "description": { "$ref": "#/$defs/prose" } }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["role", "name", "keyboard"],
      "additionalProperties": { "$ref": "#/$defs/prose" },
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "keyboard": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["keys", "action"],
            "additionalProperties": false,
            "properties": {
              "keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "action": { "$ref": "#/$defs/prose" }
            }
          }
        }
      }
    },
    "internationalization": {
      "type": "object",
      "required": ["right-to-left", "long-text"],
      "additionalProperties": { "$ref": "#/$defs/prose" }
    },
    "motion": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/prose" }
    },
    "implementations": {
      "description": "Each platform's component: its source file, from the repository root, and what it is called there. A platform with no entry has no implementation yet. The spec linter checks that each file exists and mentions the name, and the documentation's parity matrix is built from this list.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "web": { "$ref": "#/$defs/implementation" },
        "ios": { "$ref": "#/$defs/implementation" },
        "android": { "$ref": "#/$defs/implementation" }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/kebab" },
          "description": { "$ref": "#/$defs/prose" },
          "part": {
            "description": "In a spec with parts, the part the example shows.",
            "$ref": "#/$defs/kebab"
          },
          "label": { "type": "string", "minLength": 1 },
          "properties": { "type": "object" },
          "matrix": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "array", "minItems": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "properties": {
      "description": "A component's properties, or a part's, by name.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/kebab" },
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/prose" },
          "type": { "enum": ["boolean", "integer"] },
          "default": {
            "description": "The value used when none is given. When it depends on another property, an object that names that property and maps each of its values to one of this property's, such as {level: {1: heading-xl}}. A boolean, and a property with values, has a default; a whole number may have none, and is then required or unset until it is given.",
            "type": ["string", "boolean", "integer", "object"]
          },
          "required": {
            "description": "A whole number that must be given. It has no default.",
            "type": "boolean"
          },
          "minimum": { "type": "integer" },
          "maximum": { "type": "integer" },
          "values": {
            "type": "object",
            "minProperties": 2,
            "propertyNames": { "$ref": "#/$defs/kebab" },
            "additionalProperties": { "$ref": "#/$defs/prose" }
          }
        },
        "oneOf": [{ "required": ["values"] }, { "required": ["type"] }]
      }
    },
    "implementation": {
      "type": "object",
      "required": ["file", "name"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "name": {
          "description": "What the component is called on the platform, as code would name it. Several names when the component is more than one type, view, or function there.",
          "type": ["string", "array"],
          "minLength": 1,
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "kebab": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "prose": { "type": "string", "minLength": 8 }
  }
}
